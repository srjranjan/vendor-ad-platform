# Local development only.
# On Railway this is injected automatically once you link the Postgres
# service to the app service - do NOT set it by hand there.
#
# Leave unset to fall back to local sqlite (./vendor_ads.db).
#
# To run locally against Railway Postgres, use DATABASE_PUBLIC_URL from the
# Railway dashboard (the internal .railway.internal host only resolves
# inside Railway's network):
# DATABASE_URL=postgresql://user:pass@shuttle.proxy.rlwy.net:12345/railway
